<?xml version="1.0" encoding="utf-8"?>
<!-- android/app/src/main/res/xml/network_security_config.xml

     O device info da TV é http://IP:8001/api/v2/, texto claro, bloqueado por
     padrão desde o Android 9. Sem isto a descoberta falha em silêncio.

     O IP da TV é dinâmico (DHCP), então não dá para listar domínios: liberar
     cleartext em geral é o caminho prático. Declare isso no formulário de
     segurança de dados da Play Store. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
